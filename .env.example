# replay | live
DATA_MODE=replay

# Seconds between Yahoo poll cycles in live mode
POLL_INTERVAL_SECONDS=240

# Max underlyings to deep-scan per cycle
MAX_SCAN_UNDERLYINGS=120

POSTGRES_USER=uoa
POSTGRES_PASSWORD=uoa
POSTGRES_DB=uoa
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

REDIS_URL=redis://redis:6379/0

# Browser-facing API origin (the host you open in the browser)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
CORS_ORIGINS=http://localhost:3000

# Empty on the Mac. On the VPS, set a long random token (same value as DESK_TOKEN).
DESK_TOKEN=

# Grok desk review on /analysis. Server-side only. Never put this in the browser.
# XAI_API_KEY=
# XAI_MODEL=grok-4.5

# VPS (ProtectYourDoc nginx):
# CORS_ORIGINS=https://vps-43564666.vps.ovh.net
# NEXT_PUBLIC_API_URL=https://vps-43564666.vps.ovh.net/options
# NEXT_PUBLIC_WS_URL=wss://vps-43564666.vps.ovh.net/options/ws
# NEXT_PUBLIC_BASE_PATH=/options
# NEXT_PUBLIC_DESK_TOKEN=same-as-DESK_TOKEN

TZ=America/New_York
LOG_LEVEL=INFO

# Optional: Grok review of the paper book (https://console.x.ai)
# XAI_API_KEY=
# XAI_MODEL=grok-4.5
